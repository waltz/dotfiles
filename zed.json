{
  "agent_servers": {
    "Claude Code": {
      "command": "npx",
      "args": ["acp-claude-code"],
      "env": {}
    }
  },
  "agent": {
    "always_allow_tool_actions": true,
    "model_parameters": [],
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-latest"
    }
  },
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "show_whitespaces": "all",
  "remove_trailing_whitespace_on_save": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "theme": {
    "mode": "light",
    "light": "Ayu Mirage",
    "dark": "Sublime Mariana"
  },
  "auto_install_extensions": {
    "html": true,
    "catpuccin": true,
    "ruby": true,
    "0x96f": true,
    "sublime-mariana-theme": true
  },
  "edit_predictions": {
    "mode": "subtle"
  }
}
